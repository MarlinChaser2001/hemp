{% comment %}
  **The field** — the plate the merchant had made, used the way it was drawn.

  The artwork is a photograph of the hemp field with a log along the bottom edge and a genuinely
  transparent sky, so this section paints the sky in CSS and lets the photograph supply the ground.
  That keeps the type readable whatever the weather in the picture, and means the band can be any
  height the page needs without stretching a photograph.

  The log is a **shelf**: up to four objects stand on it, each in its own fixed box anchored to the
  wood, so a fat sack and a thin dropper bottle both sit on the line rather than floating over it.
  A block shows its own image, or the image of the category it points at, or — while there is no
  product photography — a built-in shot from `assets/` (`hemp-log-1…4.webp`), one per position.

  Everything about it degrades politely: no blocks, just the field; no field image, just a painted
  sky and the copy.
{% endcomment %}

<section class="hemp-field full-width">
  <div class="hemp-field__sky" aria-hidden="true"></div>

  {%- liquid
    assign plate_src = 'hemp-field.webp' | asset_url
    if section.settings.field_image != blank
      assign plate_src = section.settings.field_image | image_url: width: 2000
    endif
  -%}

  <div class="hemp-field__plate">
    <img
      class="hemp-field__img"
      src="{{ plate_src }}"
      alt=""
      width="1600"
      height="600"
      loading="lazy"
    >

    {%- if section.blocks.size > 0 -%}
      <ul class="hemp-field__shelf">
        {%- for block in section.blocks -%}
          {%- liquid
            assign cat = block.settings.collection
            assign tile_image = block.settings.image
            if tile_image == blank and cat != blank
              assign tile_image = cat.image
            endif
            if tile_image == blank and cat != blank
              assign tile_image = cat.products.first.featured_image
            endif

            assign tile_label = block.settings.label
            if tile_label == blank and cat != blank
              assign tile_label = cat.title
            endif

            assign tile_link = block.settings.link
            if tile_link == blank and cat != blank
              assign tile_link = cat.url
            endif

            assign tile_tip = block.settings.tooltip
            if tile_tip == blank
              assign tile_tip = tile_label
            endif

            comment
              Until there is product photography, a built-in shot stands in: one
              per position, in assets/. It is only a placeholder — set an image on
              the block, or point it at a category with products, and it steps
              aside.
            endcomment
            assign tile_fallback = blank
            if tile_image == blank
              assign tile_fallback = 'hemp-log-' | append: forloop.index | append: '.webp'
            endif
          -%}

          {%- if tile_image != blank or tile_fallback != blank -%}
            <li
              class="hemp-field__tile"
              style="--tile-nudge: {{ block.settings.nudge | default: 0 }}px; --tile-scale: {{ block.settings.scale | default: 100 | divided_by: 100.0 }};"
              {{ block.shopify_attributes }}
            >
              <a
                class="hemp-field__tile-link"
                href="{{ tile_link | default: routes.all_products_collection_url }}"
                data-tip="{{ tile_tip | escape }}"
                title="{{ tile_tip | escape }}"
              >
                {%- if tile_image != blank -%}
                  {{
                    tile_image
                    | image_url: width: 700
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 749px) 17vw, 40vw',
                      widths: '300,450,700',
                      class: 'hemp-field__img-tile',
                      alt: tile_label
                  }}
                {%- else -%}
                  {%- comment -%} Intrinsic sizes, for the img tag's layout hint. {%- endcomment -%}
                  {%- case forloop.index -%}
                    {%- when 1 -%}
                      {%- assign fallback_w = 415 -%}
                      {%- assign fallback_h = 640 -%}
                    {%- when 2 -%}
                      {%- assign fallback_w = 438 -%}
                      {%- assign fallback_h = 640 -%}
                    {%- when 3 -%}
                      {%- assign fallback_w = 567 -%}
                      {%- assign fallback_h = 422 -%}
                    {%- else -%}
                      {%- assign fallback_w = 187 -%}
                      {%- assign fallback_h = 640 -%}
                  {%- endcase -%}
                  <img
                    class="hemp-field__img-tile"
                    src="{{ tile_fallback | asset_url }}"
                    width="{{ fallback_w }}"
                    height="{{ fallback_h }}"
                    alt="{{ tile_label | escape }}"
                    loading="lazy"
                  >
                {%- endif -%}
                <span class="visually-hidden">{{ tile_label }}</span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  <div class="hemp-field__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hemp-eyebrow hemp-field__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    <h2 class="hemp-field__title">
      {{ section.settings.heading | escape }}
      {%- if section.settings.heading_em != blank %} <span class="hemp-em">{{ section.settings.heading_em | escape }}</span>{% endif -%}
    </h2>

    {%- if section.settings.lede != blank -%}
      <p class="hemp-field__lede">{{ section.settings.lede | escape }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <a class="hemp-btn hemp-btn--dark hemp-field__cta" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">
        <span>{{ section.settings.cta_label | escape }}</span>
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .hemp-field {
    position: relative;
    isolation: isolate;
    display: grid;
    align-content: start;
    min-height: clamp(34rem, 56vw, 47rem);
    overflow: hidden;
    /* A morning sky: the photograph's own sky is transparent, so this is what shows through. */
    background: linear-gradient(180deg, #e9f1de 0%, #f7f2e3 46%, #dee7cc 100%);
  }

  .hemp-field__sky {
    position: absolute;
    inset: 0;
    background: radial-gradient(70% 50% at 78% 12%, rgb(227 180 73 / 0.22), transparent 70%);
    z-index: 0;
  }

  /* The plate is the photograph **and its own coordinate system**: the log's top
     edge was measured at 26.7% up from the bottom of this image, flat to within a
     row across the full width, so anything standing on it is placed as a
     percentage of this box and stays on the wood at every screen size. */
  .hemp-field__plate {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    aspect-ratio: 1600 / 600;
    z-index: 1;
  }

  .hemp-field__img {
    width: 100%;
    height: 100%;
  }

  .hemp-field__inner {
    position: relative;
    z-index: 3;
    width: min(100% - 2 * var(--page-margin), var(--page-width));
    margin-inline: auto;
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(2rem, 4vw, 3rem);
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    max-width: none;
  }

  /* Lime is for dark ground; on a morning sky it vanishes, so the eyebrow goes moss. */
  .hemp-field__eyebrow {
    color: var(--hemp-moss);
  }

  .hemp-field__title {
    max-width: 22ch;
    font-size: clamp(1.9rem, 3.6vw, 3.2rem);
    line-height: 1;
    letter-spacing: -0.03em;
    font-weight: 800;
    color: var(--hemp-ink);
    text-wrap: balance;
  }

  .hemp-field__lede {
    max-width: 44ch;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--hemp-ink-soft);
  }

  .hemp-field__cta {
    margin-block-start: 0.5rem;
  }

  /* ── Products standing on the log ─────────────────────────────────────────
   * Four objects on a measured line: 26.2% up from the plate's bottom, a hair
   * below the 26.7% edge so they sit *into* the wood rather than hover over it.
   */
  .hemp-field__shelf {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 26.2%;
    z-index: 2;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hemp-field__tile {
    position: absolute;
    inset-block-end: 0;
    /* A fixed box per object, anchored by its bottom edge on the shelf line. The
       image is contained inside it and pinned to the bottom, so the base of every
       product sits on the wood whatever shape it is. Without the box a tall bottle
       takes its natural aspect ratio and runs most of the way up the section. */
    width: clamp(9rem, 18vw, 16rem);
    height: clamp(9rem, 17vw, 15rem);
    translate: -50% 0;
  }

  .hemp-field__tile:nth-child(1) {
    inset-inline-start: 17%;
  }

  .hemp-field__tile:nth-child(2) {
    inset-inline-start: 39%;
  }

  .hemp-field__tile:nth-child(3) {
    inset-inline-start: 62%;
  }

  .hemp-field__tile:nth-child(4) {
    inset-inline-start: 84%;
  }

  /* Four objects do not stand on a shelf at exactly the same height or angle,
     and the eye knows it — a degree and two pixels is all it takes. */
  .hemp-field__tile:nth-child(odd) {
    translate: -50% -2px;
    rotate: -0.8deg;
  }

  .hemp-field__tile:nth-child(even) {
    rotate: 0.7deg;
  }

  .hemp-field__tile-link {
    position: relative;
    display: block;
    /* The image is `height: 100%`, and a percentage height only resolves against
       a parent with a definite height. Without this the picture falls back to its
       intrinsic ratio, ignores the box, and hangs below the shelf line. */
    height: 100%;
    color: inherit;
    text-decoration: none;
    outline-offset: 8px;
    /* Per-object tuning from the block settings. The nudge moves this product up
       or down the log; the scale grows it **from its base** (`transform-origin`
       at the foot), so a bigger object still stands on the wood instead of
       floating. Neither touches the shared shelf line, so the other three objects
       do not move when one is adjusted. */
    translate: 0 var(--tile-nudge, 0px);
    scale: var(--tile-scale, 1);
    transform-origin: 50% 100%;
  }

  /* **The point of the whole section**: a product photograph taken on white,
   dropped onto wood. `multiply` keeps the wood and the field behind it and turns
   white into nothing, so no card, no box, no plate. A genuine cut-out PNG passes
   through untouched — which is what to use once the photography exists. */
  .hemp-field__img-tile {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom;
    mix-blend-mode: multiply;
    transition: scale 0.35s var(--hemp-ease);
  }

  /* A shadow under the object, not around the rectangle it came in. */
  .hemp-field__tile-link::after {
    content: "";
    position: absolute;
    inset-inline: 14%;
    inset-block-end: -1%;
    height: 7%;
    border-radius: 50%;
    background: radial-gradient(50% 50% at 50% 50%, rgb(26 18 10 / 0.4), transparent 72%);
    z-index: -1;
    pointer-events: none;
  }

  /* Hover, or keyboard focus: it grows and gives a little wriggle. */
  .hemp-field__tile-link:hover .hemp-field__img-tile,
  .hemp-field__tile-link:focus-visible .hemp-field__img-tile {
    scale: 1.06;
    animation: hemp-wriggle 0.6s var(--hemp-ease);
  }

  @keyframes hemp-wriggle {
    0%,
    100% {
      rotate: 0deg;
    }
    20% {
      rotate: -2.5deg;
    }
    45% {
      rotate: 2.2deg;
    }
    70% {
      rotate: -1.2deg;
    }
  }

  /* The tooltip comes from `data-tip`: no script, and it shows on focus as well as
     hover. The same words are the image's alt text and the link's title, so the
     thing a crawler reads and the thing a person reads cannot disagree. */
  .hemp-field__tile-link::before {
    content: attr(data-tip);
    position: absolute;
    inset-block-end: calc(100% + 0.35rem);
    inset-inline-start: 50%;
    translate: -50% 0.4rem;
    padding: 0.45em 0.75em;
    border-radius: 999px;
    background: var(--hemp-deep);
    color: var(--hemp-cream);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s var(--hemp-ease), translate 0.25s var(--hemp-ease);
  }

  .hemp-field__tile-link:hover::before,
  .hemp-field__tile-link:focus-visible::before {
    opacity: 1;
    translate: -50% 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hemp-field__img-tile {
      transition: none;
    }
    .hemp-field__tile-link:hover .hemp-field__img-tile,
    .hemp-field__tile-link:focus-visible .hemp-field__img-tile {
      animation: none;
      scale: 1;
    }
  }

  @media (max-width: 749px) {
    .hemp-field__tile {
      width: clamp(5.5rem, 24vw, 8rem);
      height: clamp(5.5rem, 24vw, 8rem);
    }
    .hemp-field__tile:nth-child(1) {
      inset-inline-start: 15%;
    }
    .hemp-field__tile:nth-child(2) {
      inset-inline-start: 38%;
    }
    .hemp-field__tile:nth-child(3) {
      inset-inline-start: 61%;
    }
    .hemp-field__tile:nth-child(4) {
      inset-inline-start: 84%;
    }
    /* There is no hover on a phone, and the objects are the point. */
    .hemp-field__tile-link::before {
      display: none;
    }
  }

  @media (max-width: 749px) {
    .hemp-field {
      min-height: 27rem;
    }
    /* A 2.67:1 landscape on a phone is a sliver; fill the band and let the middle go. */
    .hemp-field__plate {
      width: 100%;
      height: 58%;
      object-fit: cover;
      object-position: bottom;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Field band",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From the paddock" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sown here." },
    { "type": "text", "id": "heading_em", "label": "Heading, italic accent", "default": "Picked the same week." },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Text",
      "default": "Australian-grown hemp, cut and cold-pressed in small batches — the reason one drop does what it does."
    },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Shop the range" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Empty links to all products." },
    {
      "type": "image_picker",
      "id": "field_image",
      "label": "Replace the field artwork",
      "info": "Transparent sky, log along the bottom. Empty uses the one built into the theme."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product on the log",
      "limit": 4,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Category",
          "info": "Its image, name and link are used unless you set your own below."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "A product shot on white, or a cut-out with transparency — it is blended onto the log, so white disappears. Empty falls back to the category, then to a built-in shot."
        },
        { "type": "text", "id": "label", "label": "Name", "info": "Alt text and the link's own text." },
        { "type": "text", "id": "tooltip", "label": "Tooltip", "info": "On hover and keyboard focus. Empty uses the name." },
        { "type": "url", "id": "link", "label": "Link", "info": "Empty links to the category." },
        {
          "type": "range",
          "id": "nudge",
          "label": "Nudge up or down",
          "min": -300,
          "max": 300,
          "step": 10,
          "unit": "px",
          "default": 0,
          "info": "Positive moves this object down. One photo's padding is never the same as another's, so each object is tuned on its own."
        },
        {
          "type": "range",
          "id": "scale",
          "label": "Size",
          "min": 40,
          "max": 220,
          "step": 5,
          "unit": "%",
          "default": 100,
          "info": "Grows from the base, so a larger object still stands on the log."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Field band",
      "blocks": [{ "type": "product" }, { "type": "product" }, { "type": "product" }, { "type": "product" }]
    }
  ]
}
{% endschema %}
