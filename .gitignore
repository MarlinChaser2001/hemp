# ─────────────────────────────────────────────────────────────────────────────
# WordPress core is downloaded by scripts/setup-wp.sh, never committed.
# Everything under wp-content that belongs to THIS project is tracked below.
# ─────────────────────────────────────────────────────────────────────────────
/wordpress/*
!/wordpress/wp-content/

# wp-content: track only our own theme + our own plugins + mu-plugins.
/wordpress/wp-content/*
!/wordpress/wp-content/themes/
!/wordpress/wp-content/plugins/
!/wordpress/wp-content/mu-plugins/

# ...inside themes, only the Hemp theme is ours.
/wordpress/wp-content/themes/*
!/wordpress/wp-content/themes/hemp/

# ...inside plugins, only plugins named hemp-* are ours. WooCommerce and every
# other third-party plugin are installed by WP-CLI and stay out of git.
/wordpress/wp-content/plugins/*
!/wordpress/wp-content/plugins/hemp-*/

# Runtime/state directories never belong in a repo.
/wordpress/wp-content/uploads/
/wordpress/wp-content/upgrade/
/wordpress/wp-content/upgrade-temp-backup/
/wordpress/wp-content/cache/
/wordpress/wp-content/languages/
/wordpress/wp-content/advanced-cache.php
/wordpress/wp-content/object-cache.php
/wordpress/wp-content/db.php
/wordpress/wp-content/debug.log

# Local config & secrets.
.env
/wordpress/wp-config.php
/wordpress/.htaccess

# Tooling / OS noise.
node_modules/
vendor/
.DS_Store
Thumbs.db
*.log
