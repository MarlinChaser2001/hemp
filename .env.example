# ── Local stack (docker-compose.yml) ─────────────────────────────────────────
# Copy to .env and adjust. .env is gitignored — never commit real credentials.

# Database (MariaDB container)
DB_NAME=hemp
DB_USER=hemp
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
DB_HOST=db:3306

# WordPress
WP_PORT=8080
WP_URL=http://localhost:8080
WP_TITLE=Hemp
WP_DEBUG=1

# First admin user created by scripts/setup-wp.sh
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me
WP_ADMIN_EMAIL=you@example.com

# UID/GID the wpcli container runs as, so files it writes stay owned by you.
# Run `id -u` and `id -g` and paste the numbers.
UID=1000
GID=1000
