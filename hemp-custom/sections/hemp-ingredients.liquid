{% comment %}
  The three things the film is actually about — hemp seed oil, aloe, macadamia
  and lavender — shown as stills cut from the footage itself.

  **This is a selection, not an ingredient list.** Most of the formulas carry more
  than three; the film had room for the three that matter most, and this section is
  those three. The copy says so ("three that do the work … the rest of the formula
  is on every label") and must keep saying so — an earlier version read "Three
  ingredients. Nothing hidden.", which claimed the product contained exactly three.
  Do not "tighten" that back.

  The default images are theme assets, so the section looks finished before a
  single product photograph exists. A block's own image wins; the fallback is
  chosen by the block's position, which is why the three stills are named in the
  order the film reveals them.
{% endcomment %}

<section class="hemp-ingredients hemp-section hemp-section--forest full-width">
  <div class="hemp-ingredients__inner">
    <header class="hemp-ingredients__head">
      {%- if section.settings.kicker != blank -%}
        <p class="hemp-kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hemp-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="hemp-ingredients__intro">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </header>

    <ol class="hemp-ingredients__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          case forloop.index
            when 1
              assign fallback = 'hemp-ingredient-hemp.jpg'
            when 2
              assign fallback = 'hemp-ingredient-aloe.jpg'
            else
              assign fallback = 'hemp-ingredient-macadamia.jpg'
          endcase
        -%}
        <li class="hemp-ingredient" {{ block.shopify_attributes }}>
          <figure class="hemp-ingredient__figure">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 990px) 30vw, 88vw',
                  widths: '300,450,600,900',
                  class: 'hemp-ingredient__img',
                  alt: block.settings.name
              }}
            {%- else -%}
              <img
                class="hemp-ingredient__img"
                src="{{ fallback | asset_url }}"
                alt=""
                width="1200"
                height="675"
                loading="lazy"
              >
            {%- endif -%}
            <span class="hemp-ingredient__index" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
          </figure>

          <h3 class="hemp-ingredient__name">{{ block.settings.name | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="hemp-ingredient__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% stylesheet %}
  .hemp-ingredients__inner {
    width: min(100% - 2 * var(--page-margin), var(--page-width));
    margin-inline: auto;
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  .hemp-ingredients__head {
    display: grid;
    gap: 0.8rem;
    max-width: 46rem;
  }

  .hemp-ingredients__intro {
    font-size: 1rem;
    line-height: 1.55;
    color: rgb(248 244 232 / 0.76);
    max-width: 54ch;
  }

  .hemp-ingredients__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: clamp(1.25rem, 3vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hemp-ingredient {
    display: grid;
    gap: 0.55rem;
    align-content: start;
  }

  .hemp-ingredient__figure {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 3;
    border-radius: var(--hemp-radius);
    overflow: hidden;
    background: rgb(11 36 25 / 0.4);
  }

  .hemp-ingredient__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hemp-ingredient__index {
    position: absolute;
    inset-block-end: 0.5rem;
    inset-inline-start: 0.9rem;
    font-family: var(--hemp-display);
    font-style: italic;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
    color: var(--hemp-lime);
    text-shadow: 0 2px 18px rgb(11 36 25 / 0.55);
  }

  .hemp-ingredient__name {
    margin-block-start: 0.25rem;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .hemp-ingredient__text {
    font-size: 0.88rem;
    line-height: 1.55;
    color: rgb(248 244 232 / 0.72);
    max-width: 34ch;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ingredients",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Eyebrow", "default": "Inside the jar" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Three that do the work."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "The film picks out three — cold-pressed hemp seed oil, aloe and macadamia. They are the ones doing the work; the rest of the formula is on every label."
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "name", "label": "Name", "default": "Hemp seed oil" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Ingredients",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "name": "Hemp seed oil",
            "text": "Cold pressed and unrefined, high in omega 3 and 6 — the reason the film starts with a single golden drop."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Aloe vera",
            "text": "Straight from the leaf, for the cool, watery glide that carries the oil into skin without a greasy finish."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Macadamia and lavender",
            "text": "Macadamia for the silkiness, lavender for the calm — the note you smell before you feel it working."
          }
        }
      ]
    }
  ]
}
{% endschema %}
