# ─────────────────────────────────────────────────────────────────────────────
#  Shopify CLI — the variables it reads, and what they are for.
#
#  These are **real environment variables**, not a config file: the CLI does not
#  read `.env` itself. Export them (direnv, your shell profile, a CI secret) or
#  keep the store in `shopify.theme.toml` and use this file only as a reminder.
#
#  Precedence: flag on the command line > environment variable > shopify.theme.toml
# ─────────────────────────────────────────────────────────────────────────────

# The store to talk to. The *.myshopify.com domain, not the custom one.
# Also settable per environment in shopify.theme.toml — that is the tidier place.
SHOPIFY_FLAG_STORE=your-store.myshopify.com

# A Theme Access password (starts `shptka_`), from the Theme Access app.
# Needed by CI and any machine that cannot do a browser login. Locally, leave it
# empty and run `pnpm auth` instead.
# https://shopify.dev/docs/storefronts/themes/tools/theme-access
SHOPIFY_CLI_THEME_TOKEN=

# Turn off every interactive prompt and browser login (value `1`). A command
# missing input then fails instead of hanging — the thing to set in a pipeline.
SHOPIFY_FLAG_NO_INPUT=

# `1` permits a non-interactive push to the **live** theme. Off by default on
# purpose: pushing to live without it is refused, not confirmed.
SHOPIFY_FLAG_ALLOW_LIVE=
