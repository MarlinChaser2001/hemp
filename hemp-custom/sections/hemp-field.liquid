{% comment %}
  **The field** — the plate the merchant had made, used the way it was drawn.

  The artwork is a photograph of the hemp field with a log along the bottom edge and a genuinely
  transparent sky, so this section paints the sky in CSS and lets the photograph supply the ground.
  That keeps the type readable whatever the weather in the picture, and means the band can be any
  height the page needs without stretching a photograph.

  The log is a **shelf**: an optional product image sits on it, centred, with its own shadow — so
  the same section works as a scene (before there is product photography) and as a staged product
  shot afterwards.

  Everything about it degrades politely: no product image, just the field; no field image, just a
  painted sky and the copy.
{% endcomment %}

<section class="hemp-field full-width">
  <div class="hemp-field__sky" aria-hidden="true"></div>

  {%- liquid
    assign plate_src = 'hemp-field.webp' | asset_url
    if section.settings.field_image != blank
      assign plate_src = section.settings.field_image | image_url: width: 2000
    endif
  -%}

  <img
    class="hemp-field__plate"
    src="{{ plate_src }}"
    alt=""
    width="1600"
    height="600"
    loading="lazy"
  >

  {%- assign field_shelf = section.settings.collection -%}
  {%- if field_shelf != blank and field_shelf.products.size > 0 -%}
    <ul class="hemp-field__shelf">
      {%- for item in field_shelf.products limit: section.settings.limit -%}
        <li class="hemp-field__tile">
          <a class="hemp-field__tile-link" href="{{ item.url }}">
            {%- if item.featured_image != blank -%}
              {{
                item.featured_image
                | image_url: width: 400
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 749px) 12vw, 24vw',
                  widths: '200,300,400',
                  class: 'hemp-field__tile-img',
                  alt: item.title
              }}
            {%- endif -%}
            <span class="hemp-field__tile-name">{{ item.title }}</span>
            <span class="hemp-field__tile-price">{{ item.price | money }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- elsif section.settings.product_image != blank -%}
    <img
      class="hemp-field__product"
      src="{{ section.settings.product_image | image_url: width: 900 }}"
      alt="{{ section.settings.product_image.alt | default: '' | escape }}"
      width="{{ section.settings.product_image.width }}"
      height="{{ section.settings.product_image.height }}"
      loading="lazy"
    >
  {%- endif -%}

  <div class="hemp-field__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hemp-eyebrow hemp-field__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    <h2 class="hemp-field__title">
      {{ section.settings.heading | escape }}
      {%- if section.settings.heading_em != blank %} <span class="hemp-em">{{ section.settings.heading_em | escape }}</span>{% endif -%}
    </h2>

    {%- if section.settings.lede != blank -%}
      <p class="hemp-field__lede">{{ section.settings.lede | escape }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <a class="hemp-btn hemp-btn--dark hemp-field__cta" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">
        <span>{{ section.settings.cta_label | escape }}</span>
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .hemp-field {
    position: relative;
    isolation: isolate;
    display: grid;
    align-content: start;
    min-height: clamp(30rem, 46vw, 40rem);
    overflow: hidden;
    /* A morning sky: the photograph's own sky is transparent, so this is what shows through. */
    background: linear-gradient(180deg, #e9f1de 0%, #f7f2e3 46%, #dee7cc 100%);
  }

  .hemp-field__sky {
    position: absolute;
    inset: 0;
    background: radial-gradient(70% 50% at 78% 12%, rgb(227 180 73 / 0.22), transparent 70%);
    z-index: 0;
  }

  .hemp-field__plate {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    width: 100%;
    height: auto;
    z-index: 1;
  }

  .hemp-field__product {
    position: absolute;
    inset-block-end: 11%;
    inset-inline-start: 50%;
    translate: -50% 0;
    max-height: 46%;
    width: auto;
    z-index: 2;
    filter: drop-shadow(0 22px 18px rgb(29 20 12 / 0.35));
  }

  .hemp-field__inner {
    position: relative;
    z-index: 3;
    width: min(100% - 2 * var(--page-margin), var(--page-width));
    margin-inline: auto;
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(2rem, 4vw, 3rem);
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    max-width: none;
  }

  /* Lime is for dark ground; on a morning sky it vanishes, so the eyebrow goes moss. */
  .hemp-field__eyebrow {
    color: var(--hemp-moss);
  }

  .hemp-field__title {
    max-width: 22ch;
    font-size: clamp(1.9rem, 3.6vw, 3.2rem);
    line-height: 1;
    letter-spacing: -0.03em;
    font-weight: 800;
    color: var(--hemp-ink);
    text-wrap: balance;
  }

  .hemp-field__lede {
    max-width: 44ch;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--hemp-ink-soft);
  }

  .hemp-field__cta {
    margin-block-start: 0.5rem;
  }

  /* ── Products standing on the log ─────────────────────────────────────────
   * Objects placed on a shelf, not cards in a row: a slight angle each way and a
   * shadow underneath is what makes them sit on the wood rather than float.
   */
  .hemp-field__shelf {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 2%;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: clamp(0.5rem, 1.6vw, 1.4rem);
    margin: 0;
    padding-inline: var(--page-margin);
    list-style: none;
  }

  .hemp-field__tile {
    width: clamp(5rem, 11vw, 8.5rem);
  }

  .hemp-field__tile:nth-child(odd) {
    rotate: -1.2deg;
  }

  .hemp-field__tile:nth-child(even) {
    rotate: 1.1deg;
  }

  .hemp-field__tile-link {
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.5rem 0.65rem;
    border-radius: 1rem;
    background: rgb(255 255 255 / 0.94);
    box-shadow: 0 14px 22px -12px rgb(31 22 12 / 0.45);
    color: var(--hemp-ink);
    text-decoration: none;
    transition: translate 0.35s var(--hemp-ease), box-shadow 0.35s var(--hemp-ease);
  }

  .hemp-field__tile-link:hover {
    translate: 0 -6px;
    box-shadow: 0 20px 30px -14px rgb(31 22 12 / 0.5);
  }

  .hemp-field__tile-img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .hemp-field__tile-name {
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
    line-height: 1.2;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hemp-field__tile-price {
    font-size: 0.6rem;
    color: var(--hemp-ink-soft);
  }

  @media (max-width: 749px) {
    .hemp-field__shelf {
      inset-block-end: 1.5%;
      gap: 0.4rem;
    }
    .hemp-field__tile {
      width: clamp(4rem, 22vw, 6rem);
    }
    /* On a phone the objects are the point; the labels are noise. */
    .hemp-field__tile-name,
    .hemp-field__tile-price {
      display: none;
    }
  }

  @media (max-width: 749px) {
    .hemp-field {
      min-height: 27rem;
    }
    /* A 2.67:1 landscape on a phone is a sliver; fill the band and let the middle go. */
    .hemp-field__plate {
      width: 100%;
      height: 58%;
      object-fit: cover;
      object-position: bottom;
    }
    .hemp-field__product {
      max-height: 34%;
      inset-block-end: 16%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Field band",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From the paddock" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sown here." },
    { "type": "text", "id": "heading_em", "label": "Heading, italic accent", "default": "Picked the same week." },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Text",
      "default": "Australian-grown hemp, cut and cold-pressed in small batches — the reason one drop does what it does."
    },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Shop the range" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Empty links to all products." },
    {
      "type": "collection",
      "id": "collection",
      "label": "Products to stand on the log",
      "info": "Four works best. Empty uses the single cut-out below instead."
    },
    { "type": "range", "id": "limit", "label": "How many", "min": 2, "max": 6, "step": 1, "default": 4 },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product to stand on the log",
      "info": "One cut-out with transparency. Used when no collection is chosen."
    },
    {
      "type": "image_picker",
      "id": "field_image",
      "label": "Replace the field artwork",
      "info": "Transparent sky, log along the bottom. Empty uses the one built into the theme."
    }
  ],
  "presets": [
    {
      "name": "Field band"
    }
  ]
}
{% endschema %}
