{% comment %}
  The password screen — the first thing anyone sees while the store is protected.

  It used to be Shopify's stock screen: their logo, a green button, and the shop's
  name in a generic sans. That is what a visitor meets before they meet anything
  we made, so it wears the brand instead: the leaf from the film behind a scrim,
  the wordmark, and one lime pill.

  `{% form 'storefront_password' %}` is Shopify's own form — it sets the cookie,
  re-renders with `form.errors` when the password is wrong, and needs no
  JavaScript. The heading is a setting because the screen is the one page a
  merchant may want to rewrite for a launch.
{% endcomment %}

<section class="pw">
  <div class="pw__media" aria-hidden="true">
    <img
      src="{{ 'hemp-hero-poster.jpg' | asset_url }}"
      alt=""
      width="1920"
      height="1080"
      fetchpriority="high"
    >
    <div class="pw__scrim"></div>
    <div class="hemp-grain"></div>
  </div>

  <div class="pw__inner">
    <p class="pw__brand">{{ shop.name }}</p>

    {%- if section.settings.eyebrow != blank -%}
      <p class="hemp-eyebrow pw__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    <h1 class="pw__title">
      {{ section.settings.heading | escape }}
      {%- if section.settings.heading_em != blank %} <span class="hemp-em">{{ section.settings.heading_em | escape }}</span>{% endif -%}
    </h1>

    {%- if shop.password_message != blank -%}
      <p class="pw__lede">{{ shop.password_message }}</p>
    {%- elsif section.settings.lede != blank -%}
      <p class="pw__lede">{{ section.settings.lede | escape }}</p>
    {%- endif -%}

    {% form 'storefront_password', class: 'pw__form' %}
      {%- if form.errors -%}
        <p class="pw__error">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <label class="visually-hidden" for="password-input">{{ 'password.password' | t }}</label>
      <div class="pw__field">
        <input
          type="password"
          name="password"
          id="password-input"
          placeholder="Store password"
          autocomplete="current-password"
          required
        >
        <button type="submit" class="hemp-btn">
          <span>{{ 'password.enter' | t }}</span>
        </button>
      </div>
    {% endform %}

    <p class="pw__credit">{{ powered_by_link }}</p>
  </div>
</section>


{% stylesheet %}
  .pw {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    isolation: isolate;
    overflow: hidden;
    background: var(--hemp-deep);
    color: var(--hemp-cream);
  }

  .pw__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .pw__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 48%;
  }

  .pw__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(11 36 25 / 0.9) 0%, rgb(11 36 25 / 0.72) 42%, rgb(11 36 25 / 0.35) 100%),
      radial-gradient(90% 70% at 20% 30%, rgb(11 36 25 / 0.75), transparent 70%);
  }

  .pw__inner {
    position: relative;
    z-index: 1;
    width: min(100% - 2 * var(--page-margin), 32rem);
    margin-inline: auto;
    padding-block: clamp(2rem, 6vh, 4rem);
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }

  .pw__brand {
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .pw__eyebrow {
    margin-block-start: 0.5rem;
  }

  .pw__title {
    font-size: clamp(2rem, 4.6vw, 3.2rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    font-weight: 800;
    text-wrap: balance;
  }

  .pw__lede {
    max-width: 34ch;
    font-size: 0.95rem;
    line-height: 1.55;
    color: rgb(248 244 232 / 0.78);
  }

  .pw__form {
    width: 100%;
    margin-block-start: 0.75rem;
  }

  .pw__field {
    display: flex;
    gap: 0.5rem;
  }

  .pw__field input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 1em 1.2em;
    border: 1px solid rgb(248 244 232 / 0.24);
    border-radius: 999px;
    background: rgb(248 244 232 / 0.07);
    color: var(--hemp-cream);
    font-size: 0.95rem;
  }

  .pw__field input::placeholder {
    color: rgb(248 244 232 / 0.45);
  }

  .pw__field input:focus-visible {
    outline: 2px solid var(--hemp-lime);
    outline-offset: 2px;
  }

  .pw__error {
    margin-block-end: 0.6rem;
    font-size: 0.85rem;
    color: #ffb4a8;
  }

  .pw__error ul {
    margin: 0;
    padding-inline-start: 1.1rem;
  }

  .pw__credit {
    margin-block-start: 1.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(248 244 232 / 0.45);
  }

  .pw__credit a {
    color: inherit;
  }

  @media (max-width: 749px) {
    .pw__field {
      flex-wrap: wrap;
    }
    .pw__field .hemp-btn {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Opening soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Grown for skin." },
    { "type": "text", "id": "heading_em", "label": "Heading, italic accent", "default": "Tested on paws." },
    {
      "type": "text",
      "id": "lede",
      "label": "Line under the heading",
      "info": "The store's own password message in Online Store → Preferences replaces this when set.",
      "default": "We are packing the first orders. Enter the password if you have one."
    }
  ]
}
{% endschema %}
