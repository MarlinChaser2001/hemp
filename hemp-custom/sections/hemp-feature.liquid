{% comment %}
  **The featured product** — the film on one side, the buying block on the other.

  One product is pushed at a time, and it changes when the merchants want it to. That
  is the point: one film per push, a handful a year, instead of fifty for the range.
  So the film is not a section fixture and not tied to a product tag — the section
  takes a product and a video, and next quarter it takes a different product and a
  different video. Nothing here knows about Hemp Calm.

  The buying block is the product's own: price, compare-at price when there is one,
  a plain product form so add-to-cart works with no JavaScript, and Shopify's
  dynamic checkout button for Buy it now. A product with more than one variant gets
  "Choose options" instead of "Add to cart", because adding a blind variant is how
  people end up with the wrong size.

  If no product is picked the section degrades to the film plus its own copy, which
  is what makes it safe to add before the product exists and what a fresh home page
  shows. Nothing is fetched until the band is nearly on screen: preload="none", the
  poster until an IntersectionObserver says the band is 400 px away.
{% endcomment %}

{%- liquid
  assign feat = all_products[section.settings.product]
  assign has_product = false
  if feat and feat.id
    assign has_product = true
  endif

  assign variant = feat.selected_or_first_available_variant

  assign poster_url = 'hemp-film-poster.jpg' | asset_url
  if section.settings.poster != blank
    assign poster_url = section.settings.poster | image_url: width: 1600
  endif

  assign kicker = section.settings.kicker
  assign title = section.settings.heading
  if has_product and section.settings.use_product_title
    assign title = feat.title
  endif

  assign blurb = section.settings.lede
  if has_product and blurb == blank
    assign blurb = feat.description | strip_html | truncate: 180
  endif
-%}

<section class="hemp-feature full-width" data-hemp-feature>
  <figure class="hemp-feature__media">
    <video
      class="hemp-feature__video"
      muted
      loop
      playsinline
      preload="none"
      poster="{{ poster_url }}"
      aria-hidden="true"
      tabindex="-1"
      data-hemp-feature-video
    >
      {%- if section.settings.video != blank -%}
        {%- for source in section.settings.video.sources -%}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endfor -%}
      {%- else -%}
        <source src="{{ 'hemp-film.mp4' | asset_url }}" type="video/mp4">
      {%- endif -%}
    </video>

    {%- if section.settings.note != blank -%}
      <figcaption class="hemp-feature__frame-note">{{ section.settings.note | escape }}</figcaption>
    {%- endif -%}

    <button class="hemp-feature__toggle" type="button" data-hemp-feature-toggle aria-pressed="false">
      <span data-hemp-feature-label>Play film</span>
    </button>
  </figure>

  <div class="hemp-feature__body">
    {%- if kicker != blank -%}
      <p class="hemp-kicker">{{ kicker | escape }}</p>
    {%- endif -%}

    {%- if title != blank -%}
      <h2 class="hemp-feature__title">{{ title | escape }}</h2>
    {%- endif -%}

    {%- if has_product -%}
      <p class="hemp-feature__price">
        <span class="hemp-feature__now">{{ variant.price | money }}</span>
        {%- if variant.compare_at_price > variant.price -%}
          <s class="hemp-feature__was">{{ variant.compare_at_price | money }}</s>
          <span class="hemp-feature__save">Save {{ variant.compare_at_price | minus: variant.price | money }}</span>
        {%- endif -%}
        {%- unless variant.available -%}
          <span class="hemp-feature__soldout">Sold out</span>
        {%- endunless -%}
      </p>
    {%- endif -%}

    {%- if blurb != blank -%}
      <p class="hemp-feature__lede">{{ blurb | escape }}</p>
    {%- endif -%}

    {%- if has_product -%}
      {%- form 'product', feat, class: 'hemp-feature__form' -%}
        <input type="hidden" name="id" value="{{ variant.id }}">

        {%- if feat.has_only_default_variant -%}
          <button
            type="submit"
            class="hemp-btn hemp-btn--dark hemp-feature__buy"
            {% unless variant.available %}disabled{% endunless %}
          >
            <span>{% if variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
          </button>
        {%- else -%}
          <a class="hemp-btn hemp-btn--dark hemp-feature__buy" href="{{ feat.url }}">
            <span>Choose options</span>
          </a>
        {%- endif -%}

        {%- if section.settings.show_buy_now and variant.available -%}
          <div class="hemp-feature__instant">{{ form | payment_button }}</div>
        {%- endif -%}
      {%- endform -%}
    {%- elsif section.settings.cta_label != blank -%}
      <a class="hemp-btn hemp-btn--dark hemp-feature__buy" href="{{ section.settings.cta_link | default: '/collections/personal-care' }}">
        <span>{{ section.settings.cta_label | escape }}</span>
      </a>
    {%- endif -%}

    {%- if has_product -%}
      <a class="hemp-feature__more" href="{{ feat.url }}">
        More about {{ feat.title | escape }}<span aria-hidden="true"> &rarr;</span>
      </a>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p class="hemp-feature__footnote">{{ section.settings.footnote | escape }}</p>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    document.querySelectorAll('[data-hemp-feature]').forEach((band) => {
      if (band.dataset.init) return;
      band.dataset.init = '1';

      const video = band.querySelector('[data-hemp-feature-video]');
      const toggle = band.querySelector('[data-hemp-feature-toggle]');
      const label = toggle && toggle.querySelector('[data-hemp-feature-label]');
      if (!video) return;

      // Motion is not the default here: it starts on its own only for someone who
      // has not asked for less of it.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

      const show = (playing) => {
        if (toggle) toggle.setAttribute('aria-pressed', String(playing));
        if (label) label.textContent = playing ? 'Pause film' : 'Play film';
      };

      const start = () => {
        const played = video.play();
        if (played && played.catch) played.catch(() => {});
        show(true);
      };

      const stop = () => {
        video.pause();
        show(false);
      };

      const load = () => {
        if (video.preload !== 'auto') video.preload = 'auto';
      };

      // Nothing is fetched until the band is close to being seen.
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              io.disconnect();
              load();
              if (!reduce.matches) start();
            });
          },
          { rootMargin: '400px 0px' }
        );
        io.observe(band);
      } else {
        load();
        if (!reduce.matches) start();
      }

      toggle && toggle.addEventListener('click', () => (video.paused ? start() : stop()));
    });
  })();
</script>

{% stylesheet %}
  /* Off-white, not the deep green: the headings are ink, and ink on cream reads
     better than cream on dark for a product block that has to be scanned for a
     price. `padding-block` is what keeps the film off the log band above it. */
  .hemp-feature {
    background: var(--hemp-cream);
    color: var(--hemp-ink);
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  /* The film holds the left half, flush to the viewport edge, with the radius on
     the side that faces the copy. `object-fit: cover` because the column's height
     is set by the buying block, not by the video's own ratio. */
  .hemp-feature__media {
    position: relative;
    margin: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--hemp-forest);
    border-start-end-radius: var(--hemp-radius-lg);
    border-end-end-radius: var(--hemp-radius-lg);
    box-shadow: 0 1.25rem 2.5rem rgb(20 32 26 / 0.18);
  }

  .hemp-feature__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hemp-feature__frame-note,
  .hemp-feature__toggle {
    position: absolute;
    inset-block-end: 1rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hemp-feature__frame-note {
    inset-inline-start: 1.1rem;
    color: rgb(248 244 232 / 0.72);
  }

  .hemp-feature__toggle {
    inset-inline-end: 1.1rem;
    padding: 0.55em 0.95em;
    border: 1px solid rgb(248 244 232 / 0.28);
    border-radius: 999px;
    background: rgb(11 36 25 / 0.55);
    backdrop-filter: blur(8px);
    color: var(--hemp-cream);
    cursor: pointer;
  }

  .hemp-feature__toggle:hover {
    border-color: rgb(248 244 232 / 0.55);
  }

  .hemp-feature__body {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    max-width: 32rem;
    padding-inline-end: var(--page-margin);
  }

  .hemp-feature__title {
    font-size: clamp(1.8rem, 3.2vw, 2.9rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    font-weight: 800;
    text-wrap: balance;
  }

  .hemp-feature__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    font-variant-numeric: tabular-nums;
  }

  .hemp-feature__now {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .hemp-feature__was {
    font-size: 0.95rem;
    opacity: 0.55;
  }

  .hemp-feature__save,
  .hemp-feature__soldout {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hemp-leaf);
  }

  .hemp-feature__soldout {
    color: var(--hemp-ink-soft);
  }

  .hemp-feature__lede {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--hemp-ink-soft);
  }

  .hemp-feature__form {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
  }

  .hemp-feature__buy {
    margin-block-start: 0.4rem;
  }

  .hemp-feature__buy[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Shopify draws the dynamic checkout button itself; only its shape and face are
     ours to set, its colours are not. */
  .hemp-feature__instant {
    margin-block-start: 0.4rem;
  }

  .hemp-feature__instant .shopify-payment-button__button {
    min-height: 48px;
    border-radius: 999px;
    font-family: inherit;
    font-weight: 700;
  }

  .hemp-feature__more {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hemp-ink);
    text-decoration: underline;
    text-decoration-color: rgb(20 32 26 / 0.28);
    text-underline-offset: 0.35em;
  }

  .hemp-feature__footnote {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hemp-ink-soft);
  }

  @media (max-width: 899px) {
    .hemp-feature {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .hemp-feature__media {
      border-radius: 0;
    }

    .hemp-feature__body {
      max-width: none;
      padding-inline: var(--page-margin);
    }

    /* The frame is short on a phone and the two controls crowd it. */
    .hemp-feature__frame-note {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product to push",
      "info": "Its title, price and add-to-cart come from the store. Change this when the next push starts — one product at a time."
    },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "This month" },
    {
      "type": "checkbox",
      "id": "use_product_title",
      "label": "Use the product's own title",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Used when no product is picked, or when the title above is unticked.",
      "default": "Hemp Calm"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Text",
      "info": "Empty uses the first of the product's own description."
    },
    { "type": "text", "id": "cta_label", "label": "Button, no product picked", "default": "Shop Hemp Calm" },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link, no product picked",
      "info": "Empty links to the personal-care category."
    },
    { "type": "text", "id": "footnote", "label": "Line under the buttons", "default": "Small batch — while it lasts" },
    {
      "type": "checkbox",
      "id": "show_buy_now",
      "label": "Show Buy it now",
      "default": true,
      "info": "Shopify's own dynamic checkout button. Hidden when the product is sold out."
    },
    { "type": "header", "content": "Film" },
    {
      "type": "video",
      "id": "video",
      "label": "Film for this product",
      "info": "Pick a file from Content → Files. Empty uses the 19-second film built into the theme. One film per push — a new cut is a new file, the theme copy is never overwritten."
    },
    { "type": "text", "id": "note", "label": "Caption on the film", "default": "19 seconds, silent" },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster frame",
      "info": "Shown until the band is nearly on screen, and instead of the film for anyone who has asked for less motion."
    }
  ],
  "presets": [{ "name": "Featured product" }]
}
{% endschema %}
